{
  "name": "feedloft",
  "version": "1.0.0",
  "description": "Feedloft — a fast, keyboard-first, self-hosted RSS reader. Pay once, own it forever.",
  "private": true,
  "type": "commonjs",
  "main": "electron/main.js",
  "scripts": {
    "dev:client": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "server": "node server/index.js",
    "start": "npm run build && node server/index.js",
    "desktop": "npm run build && electron .",
    "test": "node test/smoke.js",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@mozilla/readability": "^0.5.0",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "iconv-lite": "^0.6.3",
    "jsdom": "^25.0.1",
    "multer": "^1.4.5-lts.1",
    "rss-parser": "^3.13.0",
    "sanitize-html": "^2.14.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.5",
    "lucide-react": "^0.468.0",
    "motion": "^11.15.0"
  },
  "build": {
    "appId": "co.advancedmarketing.feedloft",
    "productName": "Feedloft",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "server/**/*",
      "client/dist/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "asarUnpack": [
      "node_modules/better-sqlite3/**"
    ]
  }
}
