# Feedloft configuration
# Copy this file to .env and edit the values below.

# Port the Express server listens on.
PORT=5331

# Password for the single admin/user login. Change this before exposing
# Feedloft to the internet.
ADMIN_PASSWORD=change-me-please

# How often (in minutes) the background poller checks feeds for updates.
# Individual feeds can override this from their settings modal.
POLL_MINUTES=15
